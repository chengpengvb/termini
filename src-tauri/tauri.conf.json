{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termini",
  "version": "0.1.23",
  "identifier": "com.termini.www",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:15173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "termini"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "termini"
          ],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Termini",
    "longDescription": "Termini",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "plist/Info.macos.plist"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "plist/Termini.linux.desktop"
      },
      "rpm": {
        "desktopTemplate": "plist/Termini.linux.desktop"
      }
    },
    "iOS": {
      "developmentTeam": "P6F3GRB9QG",
      "infoPlist": "plist/Info.ios.plist"
    }
  }
}
